# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/florafind
MONGODB_URI=

# PlantNet (https://my.plantnet.org/) - image-based plant identification
PLANTNET_API_KEY=
PLANTNET_PROJECT=all

# AI provider (see src/services/aiService.js). Used to (a) write a plant
# description and translate real IMPPAT data, and (b) use its own general
# knowledge to identify market product types and give a conservative
# claim/evidence assessment.
AI_API_KEY=
AI_MODEL=

# FloraFind Assistant chatbot (see src/services/chatService.js). Reuses
# AI_API_KEY above (same Sarvam account) - only the model differs, since the
# chatbot needs a conversational model rather than the JSON-output model
# used for Plant Details.
CHAT_AI_MODEL=sarvam-105b-conversations

# Upload limits
MAX_UPLOAD_SIZE_MB=8

# Auth - secret used to sign/verify JWTs. Generate a long random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# and never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
